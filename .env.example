# Database (Neon PostgreSQL or Supabase)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Gmail SMTP for Live OTP Delivery to ANY recipient (Recommended if no custom domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gatewaypulse.auth@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM_NAME="GatewayPulse Security"
SMTP_FROM_EMAIL=gatewaypulse.auth@gmail.com

# Resend (Alternative for Custom Domains)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=GatewayPulse <onboarding@resend.dev>
